
@startuml

' Classes
abstract class Member {
    - memberNumber : String
    - name : String
    - email : String
    + maxLoans() : Integer
    + canBorrow() : Boolean
}

class StudentMember {
    - level : String
    + maxLoans() : Integer
}

class TeacherMember {
    - department : String
    + maxLoans() : Integer
}

class Loan {
    - loanDate : Date
    - dueDate : Date
    - returnDate : Date [0..1]
    + isLate() : Boolean
}

class Copy {
    - inventoryNumber : String
    - status : CopyStatus
    + isAvailable() : Boolean
}

class Book {
    - isbn : String
    - title : String
    - year : Integer
}

class Author {
    - name : String
}

class Reservation {
    - date : Date
}

enum CopyStatus {
    AVAILABLE
    BORROWED
    LOST
}

' Inheritance
Member <|-- StudentMember
Member <|-- TeacherMember

' Associations and multiplicities
Member "1" -- "0..*" Loan

Loan "loans 0..*" --> "copy 1" Copy

Copy "0..*" -- "1" Book

Book "1..*" -- "1..*" Author

Member "1" -- "0..*" Reservation

Reservation "0..*" -- "1" Book

' UML notation
skinparam classAttributeIconSize 0
hide circle

@enduml
